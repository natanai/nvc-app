      "actions": [
        {
          "id": "structured-direct-quote",
          "label": "they said exact words",
          "cueId": "structured-direct-quote",
          "lexiconKey": "structured_direct_quote",
          "segments": [
            { "type": "fixed", "value": "I heard" },
            {
              "type": "select",
              "id": "action-direct-quote-subject",
              "ariaLabel": "Who spoke",
              "options": "@subjects.default"
            },
            { "type": "fixed", "value": "say" },
            {
              "type": "input",
              "id": "action-direct-quote-quote",
              "placeholder": "exact words",
              "ariaLabel": "Exact words",
              "wrap": "doubleQuotes"
            }
          ]
        },
        {
          "id": "structured-interruption",
          "label": "they interrupted",
          "cueId": "structured-interruption",
          "lexiconKey": "structured_interruption",
          "segments": [
            { "type": "fixed", "value": "I heard" },
            {
              "type": "select",
              "id": "action-interruption-subject",
              "ariaLabel": "Who interrupted",
