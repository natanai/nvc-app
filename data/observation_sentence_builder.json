              "options": [
                { "value": "sunrise", "label": "sunrise" },
                { "value": "noon", "label": "noon" },
                { "value": "sunset", "label": "sunset" },
                { "value": "midnight", "label": "midnight" },
                { "value": "dawn", "label": "dawn" },
                { "value": "dusk", "label": "dusk" },
                {
                  "value": "",
