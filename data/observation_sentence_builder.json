            { "type": "fixed", "value": "When" },
            {
              "type": "select",
              "id": "time-when-detail",
              "ariaLabel": "Time reference",
              "options": [
                { "value": "yesterday", "label": "yesterday" },
                { "value": "today", "label": "today" },
                { "value": "this morning", "label": "this morning" },
