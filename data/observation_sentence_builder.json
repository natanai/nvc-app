              "options": [
                { "value": "our meeting", "label": "our meeting" },
                { "value": "the call", "label": "the call" },
                { "value": "the shift", "label": "the shift" },
                { "value": "the appointment", "label": "the appointment" },
                { "value": "the game", "label": "the game" },
                {
                  "value": "",
                  "label": "a specific event…",
