{
  "family": "request_denied",
  "defaults": {
    "feelings": ["disappointed", "frustrated", "anxious", "tense"],
    "needs": ["consideration", "predictability", "respect", "support"]
  },
  "cues": [
    {
      "id": "time-off-request-denied_next",
      "slots": {
        "who": ["boss", "manager", "supervisor"],
        "what_timeoff": ["time off", "pto", "vacation", "leave"]
      },
      "patterns": [
        "\\b(?:i|we)\\s+asked\\s+(?:for\\s+(?:${what_timeoff})|to\\s+take\\s+(?:${what_timeoff}))\\b[^.!?]*\\b(?:they|(?:my\\s+|the\\s+)?(?:${who}))\\s+(?:said|says)\\s+no(?:\\s+to)?\\b",
        "\\b(?:my\\s+|the\\s+)?(?:${who})\\s+(?:did\\s+not|didn[’']?t)\\s+(?:approve|allow)\\b[^.!?]*\\b(?:${what_timeoff})\\b",
        "\\b(?:they|(?:my\\s+|the\\s+)?(?:${who}))\\s+(?:denied|rejected|declined|refused)\\b[^.!?]*\\b(?:${what_timeoff})\\b",
        "\\b(?:they|(?:my\\s+|the\\s+)?(?:${who}))\\s+(?:told|tells)\\s+me\\s+no\\b[^.!?]*\\b(?:${what_timeoff})\\b|\\b(?:${what_timeoff})\\b[^.!?]*\\b(?:they|(?:my\\s+|the\\s+)?(?:${who}))\\s+(?:told|tells)\\s+me\\s+no\\b",
        "\\b(?:they|(?:my\\s+|the\\s+)?(?:${who}))\\s+(?:denied|rejected|declined|refused)\\s+(?:my\\s+)?(?:${what_timeoff})\\s+request\\b",
        "\\bmy\\s+(?:${what_timeoff})\\s+request\\s+was\\s+(?:not\\s+approved|denied|rejected)\\b",
        "\\bmy\\s+(?:${what_timeoff})\\s+request\\s+wasn[’']?t\\s+approved\\b"
      ],
      "example": "I asked for time off and my manager said no."
    },
    {
      "id": "schedule-change-request-denied_next",
      "slots": {
        "who": ["boss", "manager", "supervisor"]
      },
      "patterns": [
        "\\b(?:i|we)\\s+asked\\s+to\\s+change\\s+my\\s+schedule\\b[^.!?]*\\b(?:they|(?:my\\s+|the\\s+)?(?:${who}))\\s+(?:said|says)\\s+no(?:\\s+to)?\\b",
        "\\b(?:i|we)\\s+asked\\s+for\\s+a\\s+schedule\\s+change\\b[^.!?]*\\b(?:they|(?:my\\s+|the\\s+)?(?:${who}))\\s+(?:said|says)\\s+no(?:\\s+to)?\\b",
        "\\b(?:they|(?:my\\s+|the\\s+)?(?:${who}))\\s+(?:said|says)\\s+no\\b[^.!?]*\\b(?:when\\s+)?(?:i|we)\\s+asked\\s+(?:to\\s+change\\s+my\\s+schedule|for\\s+a\\s+schedule\\s+change)\\b",
        "\\b(?:they|(?:my\\s+|the\\s+)?(?:${who}))\\s+(?:denied|rejected|declined|refused)\\s+(?:my\\s+)?schedule\\s+change\\s+request\\b",
        "\\b(?:my\\s+|the\\s+)?(?:${who})\\s+(?:did\\s+not|didn[’']?t)\\s+approve\\s+(?:my\\s+schedule\\s+change\\s+request|a\\s+schedule\\s+change)\\b",
        "\\bmy\\s+schedule\\s+change\\s+request\\s+was\\s+(?:not\\s+approved|denied|rejected)\\b",
        "\\bmy\\s+schedule\\s+change\\s+request\\s+wasn[’']?t\\s+approved\\b"
      ],
      "example": "I asked to change my schedule and my boss said no."
    },
    {
      "id": "meeting-request-denied_next",
      "slots": {
        "who_ext": ["boss", "manager", "supervisor", "partner", "teacher", "professor", "landlord"],
        "what_meeting": ["meeting", "one on one", "1 on 1", "1:1"]
      },
      "patterns": [
        "\\b(?:i|we)\\s+asked\\s+for\\s+(?:a\\s+)?(?:${what_meeting})\\b[^.!?]*\\b(?:they|(?:my\\s+|the\\s+)?(?:${who_ext}))\\s+(?:said|says)\\s+no(?:\\s+to)?\\b",
        "\\b(?:they|(?:my\\s+|the\\s+)?(?:${who_ext}))\\s+(?:did\\s+not|didn[’']?t)\\s+approve\\s+my\\s+(?:${what_meeting})\\s+request\\b",
        "\\b(?:they|(?:my\\s+|the\\s+)?(?:${who_ext}))\\s+(?:denied|rejected|declined|refused)\\s+(?:my\\s+)?(?:${what_meeting})\\s+request\\b",
        "\\bmy\\s+(?:${what_meeting})\\s+request\\s+was\\s+(?:not\\s+approved|denied|rejected)\\b",
        "\\bmy\\s+(?:${what_meeting})\\s+request\\s+wasn[’']?t\\s+approved\\b"
      ],
      "example": "I asked for a meeting and my landlord said no."
    }
  ]
}
