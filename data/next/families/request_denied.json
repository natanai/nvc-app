{
  "family": "request_denied",
  "defaults": {
    "feelings": ["disappointed", "frustrated", "anxious", "tense"],
    "needs": ["consideration", "predictability", "respect", "support"]
  },
  "cues": [
    {
      "id": "time-off-request-denied_next",
      "slots": {
        "who": ["boss", "manager", "supervisor"],
        "what": ["time off", "pto", "vacation", "leave"]
      },
      "patterns": [
        "\\b(?:i|we) asked (?:for|to) .* (?:they|${who}) (?:said|says) no\\b",
        "\\b(?:${who}) (?:did not|didn[’']?t) (?:approve|allow) .* ${what}\\b",
        "\\bmy ${what} request was not approved\\b"
      ],
      "example": "I asked for time off and my manager said no."
    },
    {
      "id": "schedule-change-request-denied_next",
      "slots": {
        "who": ["boss", "manager", "supervisor"],
        "what": ["change my schedule", "a schedule change"]
      },
      "patterns": [
        "\\b(?:i|we) asked to ${what} and (?:they|${who}) said no\\b",
        "\\b(?:${who}) (?:did not|didn[’']?t) approve my ${what} request\\b"
      ],
      "example": "I asked to change my schedule and my boss said no."
    },
    {
      "id": "meeting-request-denied_next",
      "slots": {
        "who": ["boss", "manager", "supervisor", "partner", "teacher", "professor", "landlord"],
        "what": ["a meeting", "one on one", "1 on 1", "1:1"]
      },
      "patterns": [
        "\\bi asked for ${what} and (?:they|${who}) said no\\b",
        "\\b(?:they|${who}) (?:did not|didn[’']?t) approve my ${what} request\\b"
      ],
      "example": "I asked for a meeting and they said no."
    }
  ]
}
