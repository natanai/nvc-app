{
  "family": "late",
  "defaults": {
    "feelings": ["disappointed", "irritated", "anxious", "hurt"],
    "needs": ["reliability", "consideration", "respect", "predictability"]
  },
  "cues": [
    {
      "id": "arrived-late_next",
      "patterns": [
        "\\barrived\\s+late\\b",
        "\\bshowed\\s+up\\s+late\\b|\\bcame\\s+late\\b",
        "\\barrived\\b[^.!?]*\\bminutes?\\s+late\\b",
        "\\barrived\\b[^.!?]*\\bafter\\s+(?:it|the\\s+(?:call|meeting|event))\\s+started\\b",
        "\\bwas\\s+late\\b[^.!?]*\\bto\\s+(?:the\\s+)?(?:call|meeting|event)\\b",
        "\\bpast\\s+the\\s+agreed\\s+time\\b"
      ],
      "example": "We agreed on 2:00; they arrived late without a message."
    }
  ]
}
