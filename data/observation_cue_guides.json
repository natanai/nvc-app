{
  "guides": [
    {
      "id": "formula-date",
      "type": "formula",
      "group": "lead",
      "order": 10,
      "text": "On [DATE]",
      "patterns": [
        "\\b\\d{4}-\\d{1,2}-\\d{1,2}\\b",
        "\\b\\d{1,2}[/-]\\d{1,2}(?:[/-]\\d{2,4})?\\b",
        "\\b(?:jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|jun(?:e)?|jul(?:y)?|aug(?:ust)?|sep(?:t|tember)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)\\b",
        "\\b(?:mon(?:day)?|tue(?:sday)?|wed(?:nesday)?|thu(?:rsday)?|fri(?:day)?|sat(?:urday)?|sun(?:day)?)\\b",
        "\\b(?:today|yesterday|tonight|this\\s+(?:morning|afternoon|evening|week|month|year|weekend)|last\\s+(?:night|week|month|year|weekend|monday|tuesday|wednesday|thursday|friday|saturday|sunday)|earlier\\s+(?:today|this\\s+week|this\\s+month)|later\\s+that\\s+day|over\\s+the\\s+weekend|that\\s+(?:morning|afternoon|evening))\\b",
        "\\bon\\s+\\d{1,2}(?:st|nd|rd|th)\\b"
      ]
    },
    {
      "id": "formula-time",
      "type": "formula",
      "group": "lead",
      "order": 20,
      "text": "at [TIME]",
      "patterns": [
        "\\b\\d{1,2}:\\d{2}\\s*(?:[ap]\\.?m\\.?)?\\b",
        "\\b\\d{1,2}\\s*(?:[ap]\\.?m\\.?)\\b",
        "\\b(?:noon|midday|midnight)\\b",
        "\\b(?:morning|afternoon|evening|night|sunrise|sunset|dawn|dusk|lunchtime|breakfast|lunch|dinner)\\b",
        "\\b(?:at|around|about|by|just\\s+after|just\\s+before|during)\\s+(?:\\d{1,2}(?::\\d{2})?\\s*(?:[ap]\\.?m\\.?)?|noon|midnight)\\b",
        "\\bfrom\\s+\\d{1,2}(?::\\d{2})?\\s*(?:[ap]\\.?m\\.?)?\\s+(?:to|until|through)\\s+\\d{1,2}(?::\\d{2})?\\s*(?:[ap]\\.?m\\.?)?\\b"
      ]
    },
    {
      "id": "formula-place",
      "type": "formula",
      "group": "lead",
      "order": 30,
      "text": "in [PLACE]",
      "patterns": [
        "\\b(?:conference\\s+room|meeting\\s+room|office|kitchen|hallway|classroom|library|gym|lobby|zoom\\s+call|video\\s+call|phone\\s+call|stage|auditorium|cafeteria|cafe|restaurant|warehouse|workshop|desk|table|lab|laboratory|clinic|ward|room|break\\s+room|breakroom|kitchenette|hall|corridor|parking\\s+lot|parking\\s+garage|car|vehicle|bus|train|platform|station|airport|waiting\\s+room|lunchroom|office\\s+lobby|front\\s+desk|reception|studio|shop\\s+floor|store|market|checkout|counter|patient\\s+room|exam\\s+room|workroom)\\b"
      ]
    },
    {
      "id": "formula-sense",
      "type": "formula",
      "group": "tail",
      "order": 40,
      "text": "I saw/heard",
      "patterns": [
        "\\bI\\s+(?:saw|heard|noticed|observed|watched)\\b"
      ]
    },
    {
      "id": "formula-actor",
      "type": "formula",
      "group": "tail",
      "order": 50,
      "text": "[ACTOR]",
      "patterns": [
        "\\b(?:he|she|they|them|him|her|we|us|you|someone|somebody|anyone|anybody|everyone|everybody|staff|team|group|coworker|coworkers|colleague|colleagues|manager|supervisor|client|clients|customer|customers|participant|participants|student|students|teacher|nurse|parent|parents|child|children|neighbor|neighbour|people|person|friend|friends|guest|guests|facilitator|speaker|host)\\b",
        "\\b(?:a|an|the|this|that|these|those|my|our|your|his|her|their)\\s+[A-Za-z][\\w-]*\\b",
        "\\bI\\s+(?:saw|heard|noticed|observed|watched)\\s+(?:\"[^\"\\n]+\"|[A-Z][a-z]+(?:\\s+[A-Z][a-z]+)?)"
      ]
    },
    {
      "id": "formula-action",
      "type": "formula",
      "group": "tail",
      "order": 60,
      "text": "[ACTION/WORDS]",
      "patterns": [
        "\\b(?:said|say|says|saying|ask|asked|asking|asks|tell|tells|telling|told|shout|shouted|shouting|shouts|yell|yelled|yelling|yells|email|emailed|emailing|emails|text|texted|texting|texts|slack|slacked|slacking|slacks|message|messaged|messaging|messages|call|called|calling|calls|wrote|write|writes|writing|laugh|laughed|laughing|laughs|cry|cried|crying|cries|smile|smiled|smiling|smiles|touch|touched|touching|touches|hand|handed|handing|hands|wave|waved|waving|waves|point|pointed|pointing|points|show|showed|showing|shows|share|shared|sharing|shares|post|posted|posting|posts|present|presented|presenting|presents|arrive|arrived|arriving|arrives|leave|left|leaving|leaves|open|opened|opening|opens|close|closed|closing|closes|walk|walked|walking|walks|stand|stood|standing|stands|sit|sat|sitting|sits|give|gave|giving|gives|bring|brought|bringing|brings|offer|offered|offering|offers|remind|reminded|reminding|reminds|sign|signed|signing|signs|deliver|delivered|delivering|delivers|coach|coached|coaching|coaches|review|reviewed|reviewing|reviews|observe|observed|observing|observes|record|recorded|recording|records)\\b"
      ]
    },
    {
      "id": "formula-count",
      "type": "formula",
      "group": "tail",
      "order": 70,
      "text": "[COUNT/DURATION]",
      "patterns": [
        "\\b(?:once|twice|thrice|three\\s+times|four\\s+times|five\\s+times|six\\s+times|seven\\s+times|eight\\s+times|nine\\s+times|ten\\s+times)\\b",
        "\\bfor\\s+(?:about\\s+)?(?:a|an|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|\\d+)\\s+(?:seconds?|minutes?|hours?|days?|weeks?)\\b",
        "\\b\\d+\\s*[–-]\\s*\\d+\\b",
        "\\b\\d+%\\b",
        "\\b\\d{1,2}:\\d{2}\\s*(?:[ap]\\.?m\\.?)?\\s*(?:–|-|to)\\s*\\d{1,2}:\\d{2}\\s*(?:[ap]\\.?m\\.?)?\\b",
        "\\b\\d+\\s+(?:times?|people|folks|participants|emails|messages|calls|notes|reports|visits|students|clients|customers|guests|hours?|minutes?|seconds?|days?|weeks?|months?)\\b",
        "\\b(?:one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|hundred)\\s+(?:times?|people|folks|participants|emails|messages|calls|notes|reports|visits|students|clients|customers|guests|hours?|minutes?|seconds?|days?|weeks?|months?)\\b"
      ]
    }
  ]
}
