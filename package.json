{
  "name": "nvc-app",
  "version": "1.0.0",
  "description": "Retro Nonviolent Communication explorer with magnet play, journaling, and a localStorage-powered strategy inventory for allneeds.app",
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "lint:links": "node scripts/check-links.mjs",
    "lint:evidence": "node scripts/lint-evidence.mjs",
    "lint:entrypoints": "node scripts/lint-entrypoints.mjs",
    "build": "npm run lint:evidence && npm run build:data && npm run build:pages && npm run lint:entrypoints",
    "test:customizer": "node tests/customizer-integrity.test.mjs",
    "test:data-integrity": "node tests/data-integrity.test.mjs",
    "test:obsolete": "node tests/obsolete-references.test.mjs",
    "test:flicker-jitter": "node tests/navigation-highlight.test.mjs",
    "test:home-regressions": "node tests/home-page-regressions.test.mjs",
    "test:nav-magnets": "node tests/nav-magnet-coverage.test.mjs",
    "test:internal-links": "node tests/internal-link-integrity.test.mjs",
    "calculate:observation-feelings": "node scripts/calculateObservationFeelingCoverage.mjs",
    "extract:citations": "node scripts/extract-citations.mjs",
    "replace:needs-sources": "node scripts/replace-needs-sources.mjs",
    "validate:taxonomy": "node scripts/validateTaxonomy.mjs",
    "validate:observation-cues": "node scripts/validateObservationCues.mjs",
    "build:observation-cues": "node scripts/generateNeedObservationBlueprint.mjs && node scripts/buildObservationCueLibrary.mjs",
    "export:fact-checking": "node scripts/export-fact-checking.mjs",
    "import:fact-checking": "node scripts/import-fact-checking.mjs",
    "test:generator-stability": "node tests/generator-source-of-truth.test.mjs",
    "test:workflow-safety": "node tests/workflow-safety.test.mjs",
    "test:architecture": "npm run test:generator-stability && npm run test:workflow-safety && node tests/shared-density-polish.test.mjs && node tests/body-cues-static-first.test.mjs",
    "test:content-integrity": "npm run test:internal-links && npm run test:data-integrity",
    "test:ui-regressions": "npm run test:customizer && npm run test:flicker-jitter && npm run test:nav-magnets && npm run test:home-regressions && npm run test:obsolete",
    "verify:build-idempotent": "node scripts/verify-build-idempotency.mjs full",
    "verify:feelings-idempotent": "node scripts/verify-build-idempotency.mjs feelings",
    "verify:observation-idempotent": "node scripts/verify-build-idempotency.mjs observation-guide",
    "guard:workflow-output": "node scripts/check-workflow-output-scope.mjs"
  }
}
