{
  "name": "allneeds.app",
  "short_name": "allneeds.app",
  "description": "Build an inventory of strategies to tend to all your basic human needs. Everything stays on your device in localStorage with import and export controls.",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#FBF7FF",
  "theme_color": "#7E5CFF",
  "icons": [
    {
      "src": "icons/main.svg",
      "sizes": "384x384",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/app-icon-maskable.svg",
      "sizes": "1024x1024",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "icons/allneeds-touch.svg",
      "sizes": "1024x1024",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
