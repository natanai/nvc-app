{
  "name": "allneeds.app",
  "short_name": "AllNeeds",
  "description": "Build an inventory of strategies to tend to all your basic human needs. Everything stays on your device in localStorage with import and export controls.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
